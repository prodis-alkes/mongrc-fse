{
  "entities": {
    "Satker": {
      "title": "Satker",
      "description": "Governance, Risk, and Compliance (GRC) metrics and normalized scores for a Ditjen P2 Kemenkes RI working unit.",
      "type": "object",
      "properties": {
        "no": {
          "type": "integer",
          "description": "Official Satker serial number (1-57)"
        },
        "unitKerja": {
          "type": "string",
          "description": "Full organizational unit name"
        },
        "satker": {
          "type": "string",
          "description": "Short Satker city or unit name"
        },
        "category": {
          "type": "string",
          "enum": ["Balai Besar", "Balai Kelas I", "Balai Kelas II", "Loka", "Pusat", "Direktorat"],
          "description": "Satker classification category"
        },
        "ski": { "type": "number" },
        "spip": { "type": "number" },
        "mri": { "type": "number" },
        "iepk": { "type": "number" },
        "spipt": { "type": "number" },
        "wbkRb": { "type": "number" },
        "sakip": { "type": "number" },
        "nka": { "type": "number" },
        "ikpa": { "type": "number" },
        "ipAsn": { "type": "number" },
        "arsip": { "type": "number" },
        "pekppp": { "type": "number" },
        "pSki": { "type": "number" },
        "pSpip": { "type": "number" },
        "pMri": { "type": "number" },
        "pIepk": { "type": "number" },
        "pWbkRb": { "type": "number" },
        "pSakip": { "type": "number" },
        "pNka": { "type": "number" },
        "pIkpa": { "type": "number" },
        "pIpAsn": { "type": "number" },
        "pArsip": { "type": "number" },
        "pPekppp": { "type": "number" },
        "average": {
          "type": "number",
          "description": "Composite normalized GRC average score (0-100)"
        },
        "notes": { "type": "string" },
        "lastUpdatedBy": { "type": "string" },
        "lastUpdatedAt": { "type": "string", "format": "date-time" }
      },
      "required": [
        "no",
        "unitKerja",
        "satker",
        "category",
        "ski",
        "spip",
        "mri",
        "iepk",
        "spipt",
        "wbkRb",
        "sakip",
        "nka",
        "ikpa",
        "ipAsn",
        "arsip",
        "pSki",
        "pSpip",
        "pMri",
        "pIepk",
        "pWbkRb",
        "pSakip",
        "pNka",
        "pIkpa",
        "pIpAsn",
        "pArsip",
        "pPekppp",
        "average"
      ]
    },
    "UserProfile": {
      "title": "UserProfile",
      "description": "MonGRC user account profile and RBAC assignment (without passwords).",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "uid": { "type": "string" },
        "username": { "type": "string" },
        "email": { "type": "string", "format": "email" },
        "nip": { "type": "string" },
        "name": { "type": "string" },
        "role": {
          "type": "string",
          "enum": ["Admin", "Auditor", "Satker PIC"]
        },
        "agency": { "type": "string" },
        "assignedSatker": { "type": "string" },
        "assignedSatkerNo": { "type": "integer" },
        "avatarInitials": { "type": "string" },
        "status": {
          "type": "string",
          "enum": ["active", "inactive"]
        },
        "lastLogin": { "type": "string" },
        "createdAt": { "type": "string" }
      },
      "required": [
        "id",
        "username",
        "email",
        "nip",
        "name",
        "role",
        "agency",
        "avatarInitials",
        "status",
        "createdAt"
      ]
    },
    "UserRoleEntry": {
      "title": "UserRoleEntry",
      "description": "Email-keyed RBAC lookup entry used by security rules and login role resolution.",
      "type": "object",
      "properties": {
        "email": { "type": "string", "format": "email" },
        "userId": { "type": "string" },
        "role": {
          "type": "string",
          "enum": ["Admin", "Auditor", "Satker PIC"]
        },
        "status": {
          "type": "string",
          "enum": ["active", "inactive"]
        },
        "assignedSatker": { "type": "string" },
        "assignedSatkerNo": { "type": "integer" }
      },
      "required": ["email", "userId", "role", "status"]
    },
    "AdminGrant": {
      "title": "AdminGrant",
      "description": "Registry of UIDs granted Admin privileges.",
      "type": "object",
      "properties": {
        "uid": { "type": "string" },
        "email": { "type": "string", "format": "email" },
        "name": { "type": "string" },
        "grantedAt": { "type": "string" },
        "grantedBy": { "type": "string" }
      },
      "required": ["uid", "email", "grantedAt", "grantedBy"]
    },
    "AppConfig": {
      "title": "AppConfig",
      "description": "Global application configuration including spreadsheet edit lock and evaluation period.",
      "type": "object",
      "properties": {
        "appTitle": { "type": "string" },
        "evaluationPeriod": { "type": "string" },
        "spreadsheetEditLocked": { "type": "boolean" },
        "updatedBy": { "type": "string" },
        "updatedAt": { "type": "string", "format": "date-time" }
      },
      "required": ["appTitle", "evaluationPeriod", "spreadsheetEditLocked"]
    },
    "AuditLog": {
      "title": "AuditLog",
      "description": "Immutable audit trail record for MonGRC score, user, and configuration changes.",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "timestamp": { "type": "string" },
        "authorUid": { "type": "string" },
        "authorName": { "type": "string" },
        "authorRole": {
          "type": "string",
          "enum": ["Admin", "Auditor", "Satker PIC"]
        },
        "satkerNo": { "type": "integer" },
        "satkerName": { "type": "string" },
        "indicatorKey": { "type": "string" },
        "indicatorLabel": { "type": "string" },
        "oldValue": { "type": "string" },
        "newValue": { "type": "string" },
        "reason": { "type": "string" }
      },
      "required": [
        "id",
        "timestamp",
        "authorUid",
        "authorName",
        "authorRole",
        "satkerNo",
        "satkerName",
        "indicatorKey",
        "indicatorLabel",
        "oldValue",
        "newValue",
        "reason"
      ]
    },
    "Comment": {
      "title": "Comment",
      "description": "Threaded review comment on a Satker indicator.",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "satkerNo": { "type": "integer" },
        "indicatorKey": { "type": "string" },
        "authorId": { "type": "string" },
        "authorUid": { "type": "string" },
        "authorName": { "type": "string" },
        "authorRole": {
          "type": "string",
          "enum": ["Admin", "Auditor", "Satker PIC"]
        },
        "content": { "type": "string" },
        "createdAt": { "type": "string" },
        "status": {
          "type": "string",
          "enum": ["open", "in_review", "resolved"]
        }
      },
      "required": [
        "id",
        "satkerNo",
        "indicatorKey",
        "authorId",
        "authorUid",
        "authorName",
        "authorRole",
        "content",
        "createdAt",
        "status"
      ]
    }
  },
  "firestore": {
    "/satkers/{satkerId}": {
      "schema": { "$ref": "#/entities/Satker" },
      "description": "57 Ditjen P2 Satker GRC scorecards indexed by satker number string."
    },
    "/users/{userId}": {
      "schema": { "$ref": "#/entities/UserProfile" },
      "description": "RBAC user profiles and unit assignments. PII restricted to Admin and owner."
    },
    "/userRoles/{emailKey}": {
      "schema": { "$ref": "#/entities/UserRoleEntry" },
      "description": "Email-keyed RBAC lookup table managed by Admin."
    },
    "/admins/{uid}": {
      "schema": { "$ref": "#/entities/AdminGrant" },
      "description": "Admin role grant documents keyed by Firebase Auth UID."
    },
    "/config/{configId}": {
      "schema": { "$ref": "#/entities/AppConfig" },
      "description": "System configuration documents (primary document: app)."
    },
    "/auditLogs/{logId}": {
      "schema": { "$ref": "#/entities/AuditLog" },
      "description": "Append-only audit log entries for all score, user, and config modifications."
    },
    "/comments/{commentId}": {
      "schema": { "$ref": "#/entities/Comment" },
      "description": "Collaborative review threads attached to Satker indicators."
    }
  }
}
