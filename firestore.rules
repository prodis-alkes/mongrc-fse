rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // =========================================================================
    // Helper Functions
    // =========================================================================

    function isAuthenticated() {
      return request.auth != null;
    }

    function isVerifiedEmail() {
      return isAuthenticated() &&
             request.auth.token.email is string &&
             request.auth.token.email_verified == true;
    }

    function authEmailLower() {
      return request.auth.token.email.lower();
    }

    function isOwner(uid) {
      return isAuthenticated() && request.auth.uid == uid;
    }

    function isBootstrapAdmin() {
      return isVerifiedEmail() && authEmailLower() == 'budi.hermawan.a@gmail.com';
    }

    // Use ONLY in get/create/update/delete — NEVER inside allow list
    function hasAdminRoleDoc() {
      return isVerifiedEmail() &&
             exists(/databases/$(database)/documents/userRoles/$(authEmailLower())) &&
             get(/databases/$(database)/documents/userRoles/$(authEmailLower())).data.role == 'Admin' &&
             get(/databases/$(database)/documents/userRoles/$(authEmailLower())).data.status == 'active';
    }

    function isAdmin() {
      return isBootstrapAdmin() ||
             (isAuthenticated() && exists(/databases/$(database)/documents/admins/$(request.auth.uid))) ||
             hasAdminRoleDoc();
    }

    function isValidId(id) {
      return id is string && id.size() >= 1 && id.size() <= 128 && id.matches('^[a-zA-Z0-9._-]+$');
    }

    function isValidEmailKey(key) {
      return key is string && key.size() >= 3 && key.size() <= 160 && key.matches('^[a-z0-9._%+-]+@[a-z0-9.-]+\\.[a-z]{2,}$');
    }

    function isNonEmptyString(val, maxLen) {
      return val is string && val.size() >= 1 && val.size() <= maxLen;
    }

    function isOptionalString(data, field, maxLen) {
      return !(field in data) || data[field] == null || (data[field] is string && data[field].size() <= maxLen);
    }

    function isScore100(val) {
      return val is number && val >= 0 && val <= 100;
    }

    function isScore5(val) {
      return val is number && val >= 0 && val <= 5;
    }

    function isSpreadsheetLocked() {
      return exists(/databases/$(database)/documents/config/app) &&
             get(/databases/$(database)/documents/config/app).data.spreadsheetEditLocked == true;
    }

    function isAssignedSatkerPic(satkerNo) {
      return isVerifiedEmail() &&
             exists(/databases/$(database)/documents/userRoles/$(authEmailLower())) &&
             get(/databases/$(database)/documents/userRoles/$(authEmailLower())).data.role == 'Satker PIC' &&
             get(/databases/$(database)/documents/userRoles/$(authEmailLower())).data.status == 'active' &&
             get(/databases/$(database)/documents/userRoles/$(authEmailLower())).data.assignedSatkerNo == satkerNo;
    }

    function isAuditorUser() {
      return isVerifiedEmail() &&
             exists(/databases/$(database)/documents/userRoles/$(authEmailLower())) &&
             get(/databases/$(database)/documents/userRoles/$(authEmailLower())).data.role == 'Auditor' &&
             get(/databases/$(database)/documents/userRoles/$(authEmailLower())).data.status == 'active';
    }

    // =========================================================================
    // Entity Validators
    // =========================================================================

    function isValidSatker(data) {
      return data.keys().hasAll([
               'no', 'unitKerja', 'satker', 'category',
               'ski', 'spip', 'mri', 'iepk', 'spipt', 'wbkRb', 'sakip', 'nka', 'ikpa', 'ipAsn', 'arsip',
               'pSki', 'pSpip', 'pMri', 'pIepk', 'pWbkRb', 'pSakip', 'pNka', 'pIkpa', 'pIpAsn', 'pArsip', 'pPekppp',
               'average'
             ]) &&
             data.no is int && data.no >= 1 && data.no <= 999 &&
             isNonEmptyString(data.unitKerja, 250) &&
             isNonEmptyString(data.satker, 120) &&
             data.category in ['Balai Besar', 'Balai Kelas I', 'Balai Kelas II', 'Loka', 'Pusat', 'Direktorat'] &&
             isScore100(data.ski) &&
             isScore5(data.spip) &&
             isScore5(data.mri) &&
             isScore5(data.iepk) &&
             isScore5(data.spipt) &&
             isScore100(data.wbkRb) &&
             isScore100(data.sakip) &&
             isScore100(data.nka) &&
             isScore100(data.ikpa) &&
             isScore100(data.ipAsn) &&
             isScore100(data.arsip) &&
             (!('pekppp' in data) || data.pekppp == null || isScore5(data.pekppp)) &&
             isScore100(data.pSki) &&
             isScore100(data.pSpip) &&
             isScore100(data.pMri) &&
             isScore100(data.pIepk) &&
             isScore100(data.pWbkRb) &&
             isScore100(data.pSakip) &&
             isScore100(data.pNka) &&
             isScore100(data.pIkpa) &&
             isScore100(data.pIpAsn) &&
             isScore100(data.pArsip) &&
             isScore100(data.pPekppp) &&
             isScore100(data.average) &&
             isOptionalString(data, 'notes', 2000) &&
             isOptionalString(data, 'lastUpdatedBy', 150) &&
             isOptionalString(data, 'lastUpdatedAt', 80);
    }

    function isValidUserProfile(data) {
      return data.keys().hasAll(['id', 'username', 'email', 'nip', 'name', 'role', 'agency', 'avatarInitials', 'status', 'createdAt']) &&
             !('password' in data) &&
             isNonEmptyString(data.id, 128) &&
             isNonEmptyString(data.username, 80) &&
             isNonEmptyString(data.email, 160) &&
             isNonEmptyString(data.nip, 40) &&
             isNonEmptyString(data.name, 160) &&
             data.role in ['Admin', 'Auditor', 'Satker PIC'] &&
             isNonEmptyString(data.agency, 200) &&
             isNonEmptyString(data.avatarInitials, 10) &&
             data.status in ['active', 'inactive'] &&
             isNonEmptyString(data.createdAt, 80) &&
             isOptionalString(data, 'uid', 128) &&
             isOptionalString(data, 'assignedSatker', 120) &&
             (!('assignedSatkerNo' in data) || data.assignedSatkerNo == null || (data.assignedSatkerNo is int && data.assignedSatkerNo >= 0 && data.assignedSatkerNo <= 999)) &&
             isOptionalString(data, 'lastLogin', 80);
    }

    function isValidUserRoleEntry(data, emailKey) {
      return data.keys().hasAll(['email', 'userId', 'role', 'status']) &&
             data.email.lower() == emailKey &&
             isNonEmptyString(data.userId, 128) &&
             data.role in ['Admin', 'Auditor', 'Satker PIC'] &&
             data.status in ['active', 'inactive'] &&
             isOptionalString(data, 'assignedSatker', 120) &&
             (!('assignedSatkerNo' in data) || data.assignedSatkerNo == null || (data.assignedSatkerNo is int && data.assignedSatkerNo >= 0 && data.assignedSatkerNo <= 999));
    }

    function isValidAdminGrant(data, docUid) {
      return data.keys().hasAll(['uid', 'email', 'grantedAt', 'grantedBy']) &&
             data.uid == docUid &&
             isNonEmptyString(data.uid, 128) &&
             isNonEmptyString(data.email, 160) &&
             isOptionalString(data, 'name', 160) &&
             isNonEmptyString(data.grantedAt, 80) &&
             isNonEmptyString(data.grantedBy, 160);
    }

    function isValidAppConfig(data) {
      return data.keys().hasAll(['appTitle', 'evaluationPeriod', 'spreadsheetEditLocked']) &&
             isNonEmptyString(data.appTitle, 120) &&
             isNonEmptyString(data.evaluationPeriod, 40) &&
             data.spreadsheetEditLocked is bool &&
             isOptionalString(data, 'updatedBy', 160) &&
             isOptionalString(data, 'updatedAt', 80);
    }

    function isValidAuditLog(data) {
      return data.keys().hasAll([
               'id', 'timestamp', 'authorUid', 'authorName', 'authorRole',
               'satkerNo', 'satkerName', 'indicatorKey', 'indicatorLabel',
               'oldValue', 'newValue', 'reason'
             ]) &&
             isNonEmptyString(data.id, 128) &&
             isNonEmptyString(data.timestamp, 80) &&
             data.authorUid == request.auth.uid &&
             isNonEmptyString(data.authorName, 160) &&
             data.authorRole in ['Admin', 'Auditor', 'Satker PIC'] &&
             data.satkerNo is int && data.satkerNo >= 0 && data.satkerNo <= 999 &&
             isNonEmptyString(data.satkerName, 160) &&
             isNonEmptyString(data.indicatorKey, 80) &&
             isNonEmptyString(data.indicatorLabel, 120) &&
             isNonEmptyString(data.oldValue, 200) &&
             isNonEmptyString(data.newValue, 200) &&
             isNonEmptyString(data.reason, 500);
    }

    function isValidComment(data) {
      return data.keys().hasAll([
               'id', 'satkerNo', 'indicatorKey', 'authorId', 'authorUid',
               'authorName', 'authorRole', 'content', 'createdAt', 'status'
             ]) &&
             isNonEmptyString(data.id, 128) &&
             data.satkerNo is int && data.satkerNo >= 1 && data.satkerNo <= 999 &&
             isNonEmptyString(data.indicatorKey, 80) &&
             isNonEmptyString(data.authorId, 128) &&
             isNonEmptyString(data.authorUid, 128) &&
             isNonEmptyString(data.authorName, 160) &&
             data.authorRole in ['Admin', 'Auditor', 'Satker PIC'] &&
             isNonEmptyString(data.content, 2000) &&
             isNonEmptyString(data.createdAt, 80) &&
             data.status in ['open', 'in_review', 'resolved'];
    }

    // =========================================================================
    // Collection Rules
    // =========================================================================

    match /satkers/{satkerId} {
      allow get: if isAuthenticated() && isValidId(satkerId);
      allow list: if isAuthenticated();
      allow create: if isValidId(satkerId) && isAdmin() && isValidSatker(request.resource.data);
      allow update: if isValidId(satkerId) &&
                       isValidSatker(request.resource.data) &&
                       request.resource.data.no == resource.data.no &&
                       (isAdmin() || (!isSpreadsheetLocked() && isAssignedSatkerPic(resource.data.no)));
      allow delete: if isValidId(satkerId) && isAdmin();
    }

    match /users/{userId} {
      allow get: if isValidId(userId) && (
        isOwner(userId) ||
        (isVerifiedEmail() && resource.data.email.lower() == authEmailLower()) ||
        isAdmin()
      );
      allow list: if isBootstrapAdmin() || (
        isAuthenticated() && (
          resource.data.uid == request.auth.uid ||
          (isVerifiedEmail() && resource.data.email == authEmailLower())
        )
      );
      allow create: if isValidId(userId) && isAdmin() && isValidUserProfile(request.resource.data);
      allow update: if isValidId(userId) && isValidUserProfile(request.resource.data) && (
        isAdmin() ||
        (
          isAuthenticated() &&
          (
            userId == request.auth.uid ||
            resource.data.uid == request.auth.uid ||
            (isVerifiedEmail() && resource.data.email.lower() == authEmailLower())
          ) &&
          request.resource.data.role == resource.data.role &&
          request.resource.data.status == resource.data.status &&
          request.resource.data.assignedSatkerNo == resource.data.assignedSatkerNo &&
          request.resource.data.assignedSatker == resource.data.assignedSatker
        )
      );
      allow delete: if isValidId(userId) && isAdmin() && userId != request.auth.uid;
    }

    match /userRoles/{emailKey} {
      allow get: if isValidEmailKey(emailKey) && (
        (isVerifiedEmail() && authEmailLower() == emailKey) ||
        isAdmin()
      );
      allow list: if isBootstrapAdmin();
      allow create, update: if isValidEmailKey(emailKey) && isAdmin() && isValidUserRoleEntry(request.resource.data, emailKey);
      allow delete: if isValidEmailKey(emailKey) && isAdmin();
    }

    match /admins/{uid} {
      allow get: if isValidId(uid) && (isOwner(uid) || isBootstrapAdmin());
      allow list: if isBootstrapAdmin();
      allow create, update: if isValidId(uid) && isBootstrapAdmin() && isValidAdminGrant(request.resource.data, uid);
      allow delete: if isValidId(uid) && isBootstrapAdmin() && uid != request.auth.uid;
    }

    match /config/{configId} {
      allow get: if isAuthenticated() && isValidId(configId);
      allow list: if isAuthenticated();
      allow create, update: if isValidId(configId) && isAdmin() && isValidAppConfig(request.resource.data);
      allow delete: if false;
    }

    match /auditLogs/{logId} {
      allow get: if isAuthenticated() && isValidId(logId);
      allow list: if isAuthenticated();
      allow create: if isValidId(logId) && isAuthenticated() && isValidAuditLog(request.resource.data);
      allow update, delete: if false;
    }

    match /comments/{commentId} {
      allow get: if isAuthenticated() && isValidId(commentId);
      allow list: if isAuthenticated();
      allow create: if isValidId(commentId) &&
                       isAuthenticated() &&
                       isValidComment(request.resource.data) &&
                       request.resource.data.authorUid == request.auth.uid;
      allow update: if isValidId(commentId) &&
                       isAuthenticated() &&
                       isValidComment(request.resource.data) &&
                       request.resource.data.authorUid == resource.data.authorUid &&
                       request.resource.data.satkerNo == resource.data.satkerNo &&
                       request.resource.data.indicatorKey == resource.data.indicatorKey &&
                       (isAdmin() || isAuditorUser() || resource.data.authorUid == request.auth.uid);
      allow delete: if isValidId(commentId) && (isAdmin() || (isAuthenticated() && resource.data.authorUid == request.auth.uid));
    }

    // Default deny catch-all
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
